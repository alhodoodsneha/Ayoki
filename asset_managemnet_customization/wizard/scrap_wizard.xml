<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_scrap_wizard" model="ir.ui.view">
        <field name="name">maintenance.scrap.wizard.form</field>
        <field name="model">maintenance.scrap.wizard</field>
        <field name="arch" type="xml">
            <form string="Scrap Product">
                <group>
                    <field name="maintenance_id" readonly="1"/>
                    <field name="scrap_qty"/>
                </group>
                <footer>
                    <button name="action_scrap" string="Done" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_maintenance_scrap_wizard" model="ir.actions.act_window">
        <field name="name">Scrap Maintenance Product</field>
        <field name="res_model">maintenance.scrap.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
