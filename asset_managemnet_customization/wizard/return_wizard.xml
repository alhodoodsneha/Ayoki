<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_return_wizard" model="ir.ui.view">
        <field name="name">asset.return.wizard.form</field>
        <field name="model">asset.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Asset">
                <group>
                    <group>
                         <field name="to_loc_id" required="1"/>
                        <field name="qty" required="1"/>
                        <field name="uom_id" required="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="date_today"/>
                    </group>
                    <group>
                         <field name="from_loc_id" readonly="1"/>
                         <field name="available_qty" readonly="1"/>
                         <field name="project_id" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button type="object" name="action_return_asset" string="Return" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_return_wizard" model="ir.actions.act_window">
        <field name="name">Asset Return Wizard</field>
        <field name="res_model">asset.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_asset_return_wizard"/>
    </record>
</odoo>