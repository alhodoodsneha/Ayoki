<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_inherit_asm" model="ir.ui.view">
        <field name="name">stock.warehouse.inherit.asm</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                 <field name="project_id" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_location_form_inherit_asm" model="ir.ui.view">
        <field name="name">stock.location.inherit.asm</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='usage']" position="after">
                 <field name="project_id" readonly="1"/>
                 <field name="is_maintenance_loc"/>
            </xpath>
        </field>
    </record>
    <record id="view_stock_quant_tree_editable_inherit_asm" model="ir.ui.view">
        <field name="name">stock.quant.inherit.asm</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="after">
                 <field name="project_id" readonly="1"/>
            </xpath>
        </field>
    </record>

     <record id="view_view_picking_form_inherit_asm" model="ir.ui.view">
        <field name="name">stock.picking.inherit.asm</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                 <field name="allot_asset_id"/>
            </xpath>
        </field>
    </record>

</odoo>