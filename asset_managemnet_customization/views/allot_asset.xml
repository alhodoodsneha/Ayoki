<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_allot_asset" model="ir.ui.view">
        <field name="name">allot.asset.form.view</field>
        <field name="model">allot.asset</field>
        <field name="arch" type="xml">
            <form string="Allot Asset">
                <header>
                    <field name="stage" widget="statusbar"
                           options="{'clickable': '0', 'fold_field': 'fold'}"
                           nolabel="1" readonly="1"/>
                    <button name="action_submit" string="Submit" type="object"
                            invisible="stage != 'new'"
                            class="oe_highlight"/>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="stage != 'waiting_for_approval'"
                            groups="asset_managemnet_customization.group_approve_asset_request"
                            class="oe_highlight"/>
                     <button name="action_reject" string="Reject" type="object"
                            invisible="stage != 'waiting_for_approval'"
                            groups="asset_managemnet_customization.group_approve_asset_request"
                            class="oe_highlight"/>
                </header>
                <sheet>
                     <div class="oe_button_box" name="button_box">
                          <button name="action_view_allocated_asset" type="object"
                                string="Internal Transfer"
                                class="oe_stat_button"
                               icon="fa-list-ul">
                          </button>
                    </div>
                     <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                               <field name="project_id" readonly="stage != 'new'"/>
                            <field name="from_loc_id" required="stage != 'new'"/>
                            <field name="date_today" readonly="stage != 'new'"/>
                        </group>
                        <group>
                            <field name="to_loc_id" readonly="stage != 'new'"/>
                            <field name="requested_by" readonly="1"/>
                            <field name="requested_on" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allot Lines" name="asset_lot_lines_ids">
                            <field name="asset_lot_ids" widget="one2many">
                                <list string="Allot Lines" editable="bottom">
                                    <field name="asset_allot_id" column_invisible="1"/>
                                    <field name="is_asset_modifier" column_invisible="1"/>
                                    <field name="product_id" required="1" readonly="parent.stage != 'new'"/>
                                    <field name="uom_id" required="1" readonly="parent.stage != 'new'"/>
                                    <field name="available_qty" readonly="1"/>
                                    <field name="qty" required="1" readonly="parent.stage != 'new'"/>
                                    <field name="approved_qty" readonly="parent.stage != 'waiting_for_approval' or is_asset_modifier == False"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                 <chatter/>
            </form>
        </field>
    </record>

    <record id="view_allot_asset_tree_view" model="ir.ui.view">
        <field name="name">allot.asset.tree.view</field>
        <field name="model">allot.asset</field>
        <field name="arch" type="xml">
            <list string="Allot Asset" create="1" delete="1">
                  <field name="name" readonly="1"/>
                <field name="from_loc_id"/>
                <field name="to_loc_id"/>
                <field name="project_id" column_invisible="1"/>
                <field name="stage" widget="badge" decoration-info="stage == 'new'"
                       decoration-warning="stage == 'waiting_for_approval'"
                       decoration-success="stage == 'approved'"
                />
                <button name="action_approve" string="Approve" type="object"
                        invisible="stage != 'waiting_for_approval'"
                        class="oe_highlight"/>
            </list>
        </field>
    </record>


    <!-- Action to open the list view of estimation model -->
    <record id="action_view_allot_asset" model="ir.actions.act_window">
        <field name="name">Allot Asset</field>
        <field name="res_model">allot.asset</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_allot_asset_tree_view"/>
        <field name="help" type="html">
            <p>
                Create and manage your Allot Asset
            </p>
        </field>
    </record>

      <menuitem id="menu_asset_allocation_request"
                  name="Asset Allocation Request"
                  action="action_view_allot_asset"
                  parent="asset_managemnet_customization.menu_asset_management"
                  sequence="11"/>
</odoo>