<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_form_inherited_asm" model="ir.ui.view">
        <field name="name">project.task.form.inherit.asm</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="is_asset_task" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='description_page']" position="after">
                <page string="Asset Cost" name="project_assets" invisible="is_asset_task == False">
                    <field name="product_line_ids" widget="one2many">
                        <list string="Asset Cost" editable="bottom" create="0" delete="0">
                            <field name="task_id" column_invisible="1"/>
                            <field name="location" column_invisible="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="cost" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

