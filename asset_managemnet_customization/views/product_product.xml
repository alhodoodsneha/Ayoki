<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_asm" model="ir.ui.view">
        <field name="name">product.template.form.inherit.asm</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="options" position="inside">
                <span class="d-inline-block">
                    <field name="is_asset_product"/>
                    <label for="is_asset_product"/>
                </span>
            </div>
            <xpath expr="//field[@name='categ_id']" position="after">
                 <field name="cost_per_day" invisible="is_asset_product == False"/>
            </xpath>
        </field>
    </record>
</odoo>