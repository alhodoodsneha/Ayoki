<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_property_maintenance" model="ir.sequence">
            <field name="name">Property Maintenance</field>
            <field name="code">property.maintenance</field>
            <field name="prefix">MNC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_allot_asset_sequence" model="ir.sequence">
            <field name="name">Asset Allocation Sequence</field>
            <field name="code">allot.asset.sequence</field>
            <field name="prefix">AST/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

         <record id="seq_asset_planning_sequence" model="ir.sequence">
            <field name="name">Asset Planning Sequence</field>
            <field name="code">asset.planning.sequence</field>
            <field name="prefix">APLN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>