<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bulk_timesheet_wizard_wizard" model="ir.ui.view">
        <field name="name">bulk.timesheet.wizard.form</field>
        <field name="model">bulk.timesheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Allocation">
                <group>
                <group>
                    <field name="project_id"/>
                    <field name="date"/>
                </group>

                <group>
                    <field name="description"/>
                </group>
            </group>

                <field name="line_ids">
                    <list editable="bottom">
                        <field name="wizard_id" column_invisible="1" force_save="1"/>
                        <field name="employee_id" required="1" force_save="1"/>
                        <field name="task_id" required="1" force_save="1"/>
                        <field name="hours" required="1" force_save="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_timesheets"
                            type="object"
                            string="Create Timesheet"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>


      <record id="action_bulk_timesheet_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Timesheet</field>
        <field name="res_model">bulk.timesheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_bulk_timesheet_wizard_wizard"/>
        <field name="target">new</field>
        <field name="context"></field>
    </record>


    <menuitem action="action_bulk_timesheet_wizard"
              name="Bulk Timesheet"
              id="menu_bulk_timesheet_wizard_view"
              sequence="11"
              parent="hr_timesheet.timesheet_menu_root"
    />

</odoo>
