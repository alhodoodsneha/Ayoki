<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_project_form_inherited_milestone" model="ir.ui.view">
        <field name="name">project.project.form.inherit.milestone</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
              <xpath expr="//page[@name='description']" position="after">
              <page name="milestone_lines" string="Milestones" invisible="allow_milestones == False"
                      groups="project.group_project_milestone">
                    <group>
                        <field name="milestone_count" readonly="1"/>
                        <field name="milestone_count_reached" readonly="1"/>
                        <field name="is_milestone_exceeded" readonly="1"/>
                    </group>
                      <separator string="Milestone Lines" colspan="4" style="font-size:25px;"/>
                    <field name="milestone_ids" widget="one2many">
                        <list string="Milestones" editable="top" create="1" delete="1" decoration-success="can_be_marked_as_done"  decoration-danger="is_deadline_exceeded and not can_be_marked_as_done">
                            <field name="project_id" column_invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field name="name" readonly="project_verified == True  and is_project_modifier == False"/>
                            <field name="planned_start_date" optional="show" readonly="project_verified == True  and is_project_modifier == False"/>
                            <field name="deadline" readonly="project_verified == True  and is_project_modifier == False" string="Planned End Date"/>
                            <field name="start_date" readonly="project_verified == True  and is_project_modifier == False"/>
                            <field name="planned_end_date" optional="show" readonly="project_verified == True  and is_project_modifier == False"/>
                            <field name="weightage" readonly="project_verified == True  and is_project_modifier == False" sum="Total Weightage"/>
                            <field name="duration" readonly="1"/>
                             <field name="weightage_progress" optional="show" readonly="1"/>
                             <field name="weightage_progress" optional="show"   widget="progressbar" string="Progress Bar"/>
                            <field name="starting_delay" optional="show" readonly="1"/>
                            <field name="closing_delay" optional="show" readonly="1"/>
                            <field name="is_reached" optional="show" />
                            <field name="is_deadline_exceeded" column_invisible="1" readonly="1"/>
                            <field name="task_count" column_invisible="1" readonly="1"/>
                            <field name="can_be_marked_as_done" column_invisible="1" readonly="1"/>
                            <field name="state" readonly="1" optional="show"/>
                            <field name="remark" optional="hide"/>
                            <button name="action_view_tasks_milestones"
                                    type="object"
                                    title="View Tasks"
                                    string="View Tasks"
                                    class="btn btn-link float-end"
                                    invisible="task_count == 0"
                                   />
                             <button name="action_verify_project"
                        string="Project Verify"
                       groups="project_management.group_project_milestone_modifier"
                       invisible="project_verified == True"
                        type="object" class="btn-primary"/>
                            <button name="action_set_pending" string="Set to Pending" type="object"
                                class="oe_highlight"
                                invisible="state != 'draft'"/>
                            <button name="action_set_in_progress" string="Set to In Progress" type="object"
                                    class="oe_highlight"
                                    invisible="state != 'pending'"/>
                            <button name="action_set_completed" string="Set to Completed" type="object"
                                    class="oe_highlight"
                                    invisible="state != 'in_progress'"/>
                        </list>
                    </field>
                </page>
              </xpath>
             <xpath expr="//field[@name='user_id']" position="after">
                 <field name="lpo_reference" />
                   <field name="done_project"  invisible="1"/>
                 <field name="weightage_progress"/>
                 <field name="weightage_progress" widget="progressbar" string="Progress Bar"/>
                 <field name="bill_created" invisible="1"/>
                 <field name="project_total_amount" readonly="bill_created == True"/>
                 <field name="bill_percentage" readonly="1"/>
             </xpath>
             <xpath expr="//field[@name='partner_id']" position="after">
                  <field name="employee_ids"  widget="many2many_tags" readonly="1"/>
             </xpath>
               <xpath expr="//button[@name='action_open_share_project_wizard']" position="after">
                   <button name="action_create_payment_certificate"
                        string="Create Payment Certificate"
                        type="object" class="btn-primary"/>

                   <button name="action_allocate_employee"
                        string="Employee Allocation"
                        type="object" class="btn-primary"/>

               </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                 <button name="action_view_payment_certificate" type="object"
                        string="Payment Certificate"
                        class="oe_stat_button"
                       icon="fa-money">
                </button>

                <button name="action_view_project_manpower_planing" type="object"
                        string="Manpower Planning"
                        class="oe_stat_button"
                       icon="fa-users">
                </button>

                <button name="action_view_absent_employee" type="object"
                        string="Absent Employees"
                        class="oe_stat_button"
                       icon="fa-user-times">
                </button>
            </xpath>
        </field>
    </record>


     <record id="project_project_stage_view_tree_inherited" model="ir.ui.view">
        <field name="name">project.project.stage.view.list.inherited</field>
        <field name="model">project.project.stage</field>
        <field name="inherit_id" ref="project.project_project_stage_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="done_project" />
            </xpath>
        </field>
    </record>



</odoo>